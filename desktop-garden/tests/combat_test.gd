extends SceneTree
var game
var checks = 0
var failures: Array = []
func verify(ok, text_value):
 checks += 1
 if not ok: failures.append(text_value); push_error(text_value)
func clean():
 game.practice = true; game.reset_game(); game.sun = 10000; game.phase = "play"; game.wave_timer = 10000; game.sky_timer = 10000
func _initialize(): call_deferred("run")
func run():
 game = load("res://Main.tscn").instantiate(); root.add_child(game)
 await process_frame
 game.set_process(false)
 clean()
 verify(game.place("pea",0,0),"plant placement succeeds")
 verify(game.sun==9925,"plant cost deducted once")
 verify(not game.place("pea",1,0),"packet cooldown blocks another placement")
 verify(not game.place("wallnut",0,0),"occupied grid blocks planting")
 verify(not game.place("wallnut",9,0),"out of bounds blocks planting")
 clean()
 game.place("pea",0,0)
 var p = game.plants[0]; var pos=game.center_at(0,0)
 var z=game.add_zombie(0,"basic",pos.x+85)
 game.fire(p); game.tick_bullet(game.bullets[0],0.2)
 verify(z.hp==180,"swept projectile hits crossed zombie")
 verify(not game.bullets[0].alive,"ordinary projectile consumed")
 var other=game.add_zombie(1,"basic",pos.x+85)
 verify(other.hp==200,"no cross-lane damage")
 clean()
 game.place("sweetpea",0,0);p=game.plants[0];pos=game.center_at(0,0)
 z=game.add_zombie(0,"basic",pos.x+85);other=game.add_zombie(1,"basic",pos.x+95)
 game.fire(p);game.tick_bullet(game.bullets[0],0.2)
 verify(z.hp==160 and z.stalled==2,"candy direct damage and non-ice slow")
 verify(other.hp==190,"candy nearby splash excludes direct hit")
 clean()
 var hit=game.add_zombie(2,"basic",game.center_at(4,2).x)
 var adjacent=game.add_zombie(1,"basic",game.center_at(3,1).x)
 var opposite=game.add_zombie(3,"basic",game.center_at(5,3).x)
 var far_col=game.add_zombie(2,"basic",game.center_at(6,2).x)
 var far_row=game.add_zombie(0,"basic",game.center_at(4,0).x)
 game.apply_candy_slow(hit)
 verify(hit.stalled==2 and adjacent.stalled==2 and opposite.stalled==2,"candy slow covers full 3x3 cells including diagonal neighbors")
 verify(far_col.stalled==0 and far_row.stalled==0,"candy slow excludes zombies outside 3x3")
 verify(adjacent.hp==200 and opposite.hp==200,"expanded slow does not expand or add splash damage")
 clean()
 game.place("sweetpea",0,0);p=game.plants[0];pos=game.center_at(0,0)
 z=game.add_zombie(0,"giant",pos.x+85);other=game.add_zombie(0,"giant",pos.x+130)
 game.fire(p,true);game.tick_bullet(game.bullets[0],0.4)
 verify(z.hp==1800 and other.hp==1800,"plant food candy pierces multiple targets")
 game.tick_bullet(game.bullets[0],0.1)
 verify(z.hp==1800,"piercing projectile never hits same zombie twice")
 clean()
 game.place("pea",0,0);game.place("torchwood",1,0);p=game.plants[0];pos=game.center_at(0,0)
 z=game.add_zombie(0,"basic",game.center_at(1,0).x+60);z.slow=8
 game.fire(p);game.tick_bullet(game.bullets[0],0.5)
 verify(z.hp==150,"fire pea doubles damage and adds 25 percent against ice slow")
 verify(z.slow==0 and z.freeze==0,"fire clears ice conditions")
 clean()
 game.place("snowpea",0,0);p=game.plants[0];pos=game.center_at(0,0)
 z=game.add_zombie(0,"basic",pos.x+85)
 game.fire(p);game.bullets[0].frozen=true;game.tick_bullet(game.bullets[0],0.2)
 verify(z.freeze==1,"freezing pea applies freeze")
 clean()
 game.place("megapuff",0,0);p=game.plants[0];p.age=29.99
 game.tick(0.02)
 verify(game.plants.is_empty(),"Mega Puff expires at 30 seconds")
 clean()
 game.place("megapuff",0,0);p=game.plants[0];p.timer=0;pos=game.center_at(0,0)
 game.add_zombie(0,"giant",pos.x+320)
 for i in range(40): game.tick(1.0/60)
 verify(game.bullets.size()==4,"Mega Puff shoots four projectiles per original animation burst")
 clean()
 game.place("squash",0,0);p=game.plants[0];pos=game.center_at(0,0);z=game.add_zombie(0,"giant",pos.x+70)
 for i in range(300):game.tick(1.0/60)
 verify(z.hp==2400,"Squash deals exactly two hits of 600")
 verify(game.plants.is_empty(),"Squash leaves after second slam")
 clean()
 game.place("wallnut",0,0);z=game.add_zombie(0,"basic",game.center_at(0,0).x)
 var old_x=z.x;game.tick(1.0/60)
 verify(z.x==old_x and game.plants[0].hp<4000,"zombie stops to eat plant")
 clean()
 z=game.add_zombie(2,"giant",game.ORIGIN.x-20);game.tick(1.0/60)
 verify(game.mowers[2].state=="active","mower activates on breach")
 verify(z.hp<=0,"mower removes breached zombie")
 clean()
 game.mowers[0].state="spent";game.add_zombie(0,"basic",game.ORIGIN.x-20);game.tick(1.0/60)
 verify(game.phase=="lost","second breach ends match")
 clean()
 game.profile_path="user://test_profile.cfg";game.wave=9;game.tick(1.0/60)
 verify(game.phase=="won","last wave cleared wins match")
 clean()
 game.wave_timer=0
 for i in range(60*4):game.tick(1.0/60)
 verify(game.wave==1 and not game.zombies.is_empty(),"wave scheduler spawns zombies")
 game.spawn_sun(Vector2(500,300),350)
 verify(game.suns[-1].ttl==12,"sun has finite lifetime")
 game.practice=false;game.reset_game()
 verify(game.sun==275 and game.wave==0 and game.plants.is_empty() and game.mowers.size()==5,"restart clears match state")
 print("COMBAT TESTS: ",checks," checks, ",failures.size()," failures")
 game.queue_free();await process_frame
 quit(0 if failures.is_empty() else 1)
